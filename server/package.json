{
    "name": "talkcircle-server",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "dev": "tsx watch src/server.ts",
        "lint": "eslint .",
        "seed": "tsx src/scripts/seed.ts",
        "start": "node --enable-source-maps dist/server.js",
        "test:api": "newman run ../postman/talkcircle.postman_collection.json -e ../postman/local.postman_environment.json",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "cors": "^2.8.6",
        "dotenv": "^18.0.8",
        "express": "^5.3.0",
        "express-rate-limit": "^8.7.1",
        "helmet": "^8.3.0",
        "mongoose": "^9.11.2",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.6.5",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.13.0",
        "newman": "^6.2.3",
        "supertest": "^7.3.1",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    }
}
