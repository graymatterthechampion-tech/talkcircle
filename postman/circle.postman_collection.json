  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => {\n  pm.response.to.have.status(200);\n});\n\npm.test(\"database is connected\", () => {\n  const body = pm.response.json();\n  pm.expect(body.status).to.eql(\"ok\");\n  pm.expect(body.db).to.eql(\"connected\");\n  pm.expect(body.uptime).to.be.a(\"number\");\n});\n\npm.test(\"response is not cacheable\", () => {\n  pm.response.to.have.header(\"Cache-Control\", \"no-store\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "New Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "   pm.test(\"status is 404\", () => {\n     pm.response.to.have.status(404);\n   });\n\n   pm.test(\"error has the standard shape\", () => {\n     const body = pm.response.json();\n     pm.expect(body.error.code).to.eql(\"NOT_FOUND\");\n     pm.expect(body.error.message).to.be.a(\"string\");\n   });"
                ]
              }
            }
          ],
